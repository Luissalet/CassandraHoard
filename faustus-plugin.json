{
  "schema": 1,
  "id": "cassandra",
  "name": "Cassandra's Hoard · Talos",
  "purpose": "Absorbed by Talos's Hoard. Compatibility identity only; no standalone server. Observability for the local AI stack: which local services (the workspace, llama-server, Ollama, ComfyUI, the launcher and every Hoard app) are up, what went down and when, what else changed at that moment, what the logs said, what the GPUs were doing, whether the user's public websites are up (HTTP, TLS certificate, DNS, domain expiry), and opt-in restarts.",
  "capabilities": [
    "service-status",
    "health-checks",
    "incidents",
    "probable-cause",
    "uptime-history",
    "log-search",
    "log-tailing",
    "gpu-timeline",
    "vram",
    "restart-policies",
    "restart",
    "watch-list",
    "reboot-detection",
    "audit-trail",
    "agent-calls",
    "secrets-audit",
    "event-bus",
    "public-sites",
    "site-uptime",
    "tls-certificates",
    "domain-expiry",
    "faustus-attention",
    "faustus-farm",
    "running-agents",
    "period-budget"
  ],
  "placeholders": [
    "CASSANDRA_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "PYTHON"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5220/services",
    "TOKEN_FILE": "{CASSANDRA_DIR}/data/mcp-token",
    "PYTHON": "{CASSANDRA_DIR}/venv/Scripts/python.exe",
    "TALOS_DIR": "{CASSANDRA_DIR}/../Talos's Hoard"
  },
  "app": {
    "url_default": "http://127.0.0.1:5220/services",
    "ui_url": "http://127.0.0.1:5220/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "absorbed-cassandra"
      }
    },
    "identify": {
      "service": [
        "cassandra-hoard"
      ],
      "title": [
        "cassandra's hoard",
        "vigía del stack local"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{TALOS_DIR}/.venv/Scripts/python.exe",
    "args": [
      "{TALOS_DIR}/mcp_server.py"
    ],
    "env": {
      "TALOS_URL": "http://127.0.0.1:5220",
      "TALOS_TOKEN_FILE": "{TALOS_DIR}/data/mcp-token"
    },
    "optional_env": [
      "TALOS_DATA_DIR"
    ]
  },
  "x-family": {
    "agenda": true,
    "copilot": {
      "provider": "faustus",
      "contract": "1.0",
      "panel": "/api/copilot/panel.js",
      "context": [
        "service",
        "site",
        "incident",
        "gpu",
        "filters",
        "editor"
      ]
    },
    "absorbed_by": {
      "id": "talos",
      "repository": "https://github.com/Luissalet/TalosHoard",
      "module": "services",
      "standalone": false
    }
  },
  "notes": "Absorbed by Talos's Hoard: https://github.com/Luissalet/TalosHoard. Compatibility identity only. Start the merged app explicitly and enable its module there. This entry preserves family calls, tokens and existing data; it never owns or stops the merged process."
}
